  "agents": {
    "defaults": {
      "model": {
        "primary": "siliconflow/Pro/moonshotai/Kimi-K2.5",
        "fallbacks": [
          "siliconflow/deepseek-ai/DeepSeek-V3",
          "siliconflow/Pro/zai-org/GLM-5",
          "zhipu/glm-5",
          "n1n/claude-3-5-sonnet-20241022",
          "openrouter/deepseek/deepseek-chat",
          "openrouter/stepfun/step-3.5-flash:free",
          "openrouter/nvidia/nemotron-nano-12b-v2-vl:free"
        ]
      },
      "imageModel": {
        "primary": "siliconflow/deepseek-ai/deepseek-vl2"
      },
      "memorySearch": {
        "enabled": false,
        "provider": "local",
        "store": {
          "driver": "sqlite",
          "path": "~/.openclaw/memory/{agentId}.sqlite"
        }
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      }
    },
    "list": {
      "$include": [
        "./config/agents/main.json",
        "./config/agents/coder.json"
      ]
    }
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "bindings": [
    {
      "agentId": "main",
      "match": {
        "channel": "feishu",
        "accountId": "main"
      }
    },
    {
      "agentId": "coder",
      "match": {
        "channel": "feishu",
        "accountId": "coder"
      }
    }
  ],
  "channels": {
    "feishu": {
      "domain": "feishu",
      "dmPolicy": "open",
      "groupPolicy": "open",
      "historyLimit": 20,
      "streaming": false,
      "enabled": true,
      "allowFrom": [
        "*"
      ],
      "accounts": {
        "main": {
          "appId": "cli_a9f35ca688799cd4",
          "appSecret": "YOUR_API_KEY_HERE",
          "botName": "Main Agent Bot",
          "enabled": true
        },
        "coder": {
          "appId": "cli_your_second_app_id",
          "appSecret": "YOUR_API_KEY_HERE",
          "botName": "Coder Agent Bot",
          "enabled": true
        }
      }
    }
  },
  "gateway": {
    "port": 59999,
    "mode": "local",
    "controlUi": {
      "allowInsecureAuth": true,
      "dangerouslyDisableDeviceAuth": true
    },
    "auth": {
      "mode": "token",
      "token": "YOUR_API_KEY_HERE"
    }
  },
  "skills": {
    "load": {
      "extraDirs": [
